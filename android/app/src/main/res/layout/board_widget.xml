<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: "+ Add a note" and a voice-note button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:text="@string/widget_add"
        android:textColor="#E8E6E3"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:contentDescription="@string/widget_add" />

    <TextView
        android:id="@+id/widget_voice"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="🎙"
        android:textSize="20sp"
        android:contentDescription="@string/widget_voice" />
</LinearLayout>
