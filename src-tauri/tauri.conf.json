{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board Dev",
  "version": "0.2.0",
  "identifier": "com.nzimmerapps.board.dev",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Board Dev",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "backgroundColor": "#0d0f0e",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "nzimmer-apps",
    "shortDescription": "Capture anything, find it later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
